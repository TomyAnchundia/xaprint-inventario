<dialog id="product-modal" class="modal-card w-[min(560px,calc(100%-2rem))]">
  <form id="product-form" method="dialog">
    <div class="modal-heading"><div><h2 id="product-modal-title" class="text-lg font-bold">Nuevo producto</h2><p class="mt-1 text-xs text-slate-500">Cada variante tendrá su propio stock y código de barras.</p></div><button type="button" class="modal-close" data-close="product-modal" aria-label="Cerrar">✕</button></div>
    <div class="grid gap-4 p-5 sm:grid-cols-2">
      <input name="productId" type="hidden" />
      <label class="form-label sm:col-span-2">Nombre del producto<input class="form-input" name="name" required maxlength="80" placeholder="Ej. Camiseta clásica" /></label>
      <label class="form-label">SKU automático<input id="product-sku-display" class="form-input bg-slate-50 font-mono" value="Se asignará al guardar" readonly /></label>
      <label class="form-label">Categoría<select id="product-category" class="form-input" name="categoryId" required></select></label>
      <label class="form-label">Precio base ($)<input id="product-price" class="form-input" name="price" type="number" min="0.01" step="0.01" required placeholder="12.50" /></label>
      <fieldset id="box-options" class="hidden sm:col-span-2">
        <legend class="form-label mb-2">Venta por caja</legend>
        <label class="flex items-center gap-2 text-xs font-medium text-slate-600"><input id="product-sells-by-box" type="checkbox" class="accent-blue-700" />Permitir vender este producto por caja</label>
        <div id="box-price-fields" class="mt-3 grid gap-4 sm:grid-cols-2" hidden>
          <label class="form-label">Unidades por caja<input class="form-input" name="unitsPerBox" type="number" min="2" step="1" placeholder="36" /></label>
          <label class="form-label">Precio de caja ($)<input class="form-input" name="boxPrice" type="number" min="0.01" step="0.01" placeholder="33.00" /></label>
        </div>
      </fieldset>
      <fieldset id="size-options" class="hidden sm:col-span-2">
        <legend class="form-label mb-2">Tallas</legend>
        <div id="product-sizes" class="flex flex-wrap gap-3"></div>
        <div id="product-size-prices" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
      </fieldset>
      <fieldset id="color-options" class="hidden sm:col-span-2">
        <legend class="form-label mb-2">Colores (opcional)</legend>
        <div id="product-colors" class="flex flex-wrap gap-3"></div>
      </fieldset>
      <fieldset class="sm:col-span-2">
        <legend id="product-variants-label" class="form-label mb-2">Variantes y existencias iniciales</legend>
        <p class="mb-2 text-xs text-slate-500">Configura el precio de cada talla. Cada combinación de talla y color tendrá su propio stock y mínimo.</p>
        <div id="product-variants" class="max-h-64 space-y-2 overflow-y-auto rounded-xl border border-[#edf0ec] p-3"><p class="text-xs text-slate-400">Configura tallas o colores para administrar sus existencias.</p></div>
      </fieldset>
    </div>
    <div class="flex justify-end gap-2 border-t border-[#edf0ec] p-4"><button type="button" class="secondary-button" data-close="product-modal">Cancelar</button><button id="save-product-button" type="submit" class="primary-button">Guardar producto</button></div>
  </form>
</dialog>

<dialog id="colores-modal" class="modal-card w-[min(430px,calc(100%-2rem))]">
  <form id="color-form" method="dialog">
    <div class="modal-heading"><div><h2 class="text-lg font-bold">Administrar colores</h2><p class="mt-1 text-xs text-slate-500">Cada variante de color tendrá stock y código de barras propios.</p></div><button type="button" class="modal-close" data-close="colores-modal" aria-label="Cerrar">✕</button></div>
    <div class="space-y-4 p-5">
      <input name="colorId" type="hidden" />
      <label class="form-label"><span id="color-form-label">Nuevo color</span><div class="mt-1 flex gap-2"><input id="color-name" class="form-input" name="name" required maxlength="30" placeholder="Ej. Azul marino" /><button id="save-color-button" type="submit" class="primary-button">Agregar</button></div></label>
      <button id="cancel-color-edit" type="button" class="secondary-button hidden">Cancelar edición</button>
      <div><h3 class="mb-2 text-xs font-semibold text-slate-600">Colores disponibles</h3><ul id="colores-list" class="space-y-1"></ul></div>
    </div>
    <div class="flex justify-end border-t border-[#edf0ec] p-4"><button type="button" class="secondary-button" data-close="colores-modal">Cerrar</button></div>
  </form>
</dialog>

<dialog id="delete-product-modal" class="modal-card w-[min(430px,calc(100%-2rem))]">
  <div class="modal-heading">
    <div>
      <h2 class="text-lg font-bold">Eliminar producto</h2>
      <p class="mt-1 text-xs text-slate-500">Confirma si deseas eliminar este producto del catálogo.</p>
    </div>
    <button type="button" class="modal-close" data-close="delete-product-modal" aria-label="Cerrar">✕</button>
  </div>
  <div class="space-y-3 p-5">
    <p class="text-sm text-slate-700">¿Estás seguro de que deseas eliminar <strong id="delete-product-name"></strong>?</p>
    <p class="text-xs text-slate-500">Sus ventas y movimientos anteriores se conservarán.</p>
  </div>
  <div class="flex justify-end gap-2 border-t border-[#edf0ec] p-4">
    <button type="button" class="secondary-button" data-close="delete-product-modal">Cancelar</button>
    <button id="confirm-delete-product" type="button" class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700">Eliminar producto</button>
  </div>
</dialog>

<dialog id="customer-account-modal" class="modal-card w-[min(700px,calc(100%-2rem))]">
  <div id="customer-account-content"></div>
</dialog>

<dialog id="tallas-modal" class="modal-card w-[min(430px,calc(100%-2rem))]">
  <form id="talla-form" method="dialog">
    <div class="modal-heading"><div><h2 class="text-lg font-bold">Administrar tallas</h2><p class="mt-1 text-xs text-slate-500">Las tallas se podrán reutilizar en distintos productos.</p></div><button type="button" class="modal-close" data-close="tallas-modal" aria-label="Cerrar">✕</button></div>
    <div class="space-y-4 p-5">
      <input name="sizeId" type="hidden" />
      <label class="form-label"><span id="size-form-label">Nueva talla</span><div class="mt-1 flex gap-2"><input id="size-name" class="form-input" name="name" required maxlength="20" placeholder="Ej. XXL o 35" /><button id="save-size-button" type="submit" class="primary-button">Agregar</button></div></label>
      <button id="cancel-size-edit" type="button" class="secondary-button hidden">Cancelar edición</button>
      <div><h3 class="mb-2 text-xs font-semibold text-slate-600">Tallas disponibles</h3><ul id="tallas-list" class="space-y-1"></ul></div>
    </div>
    <div class="flex justify-end border-t border-[#edf0ec] p-4"><button type="button" class="secondary-button" data-close="tallas-modal">Cerrar</button></div>
  </form>
</dialog>

<dialog id="movement-modal" class="modal-card w-[min(430px,calc(100%-2rem))]">
  <form id="movement-form" method="dialog">
    <div class="modal-heading"><div><h2 class="text-lg font-bold">Registrar movimiento</h2><p class="mt-1 text-xs text-slate-500">Ajusta las existencias de un producto.</p></div><button type="button" class="modal-close" data-close="movement-modal" aria-label="Cerrar">✕</button></div>
    <div class="space-y-4 p-5">
      <label class="form-label">Producto y talla<select id="movement-product" class="form-input" name="variantId" required></select></label>
      <label class="form-label">Tipo de movimiento<select class="form-input" name="type"><option value="Ingreso">Ingreso</option><option value="Salida">Salida</option></select></label>
      <label class="form-label">Cantidad<input class="form-input" name="quantity" type="number" min="1" step="1" required placeholder="1" /></label>
    </div>
    <div class="flex justify-end gap-2 border-t border-[#edf0ec] p-4"><button type="button" class="secondary-button" data-close="movement-modal">Cancelar</button><button type="submit" class="primary-button">Guardar movimiento</button></div>
  </form>
</dialog>

<dialog id="sale-confirm-modal" class="modal-card w-[min(560px,calc(100%-2rem))]">
  <div id="sale-confirm-content"></div>
</dialog>

<dialog id="sale-receipt-modal" class="modal-card w-[min(500px,calc(100%-2rem))]">
  <div id="sale-receipt-content"></div>
</dialog>

<dialog id="barcode-modal" class="modal-card w-[min(460px,calc(100%-2rem))]">
  <div id="barcode-content"></div>
</dialog>

<dialog id="customer-modal" class="modal-card w-[min(430px,calc(100%-2rem))]">
  <form id="customer-form" method="dialog">
    <div class="modal-heading"><div><h2 id="customer-modal-title" class="text-lg font-bold">Nuevo cliente</h2><p id="customer-modal-description" class="mt-1 text-xs text-slate-500">Agrega los datos de contacto del cliente.</p></div><button type="button" class="modal-close" data-close="customer-modal" aria-label="Cerrar">✕</button></div>
    <div class="space-y-4 p-5">
      <input name="customerId" type="hidden" />
      <label class="form-label">Nombre completo<input class="form-input" name="name" required maxlength="80" placeholder="Ej. María López" /></label>
      <label class="form-label">Teléfono<input class="form-input" name="phone" type="tel" maxlength="20" required placeholder="099 123 4567" /></label>
      <label class="form-label">Cédula (opcional)<input class="form-input" name="cedula" maxlength="20" placeholder="Número de cédula" /></label>
      <label class="form-label">Dirección (opcional)<input class="form-input" name="direccion" maxlength="250" placeholder="Dirección del cliente" /></label>
    </div>
    <div class="flex justify-end gap-2 border-t border-[#edf0ec] p-4"><button id="cancel-customer-form" type="button" class="secondary-button" data-close="customer-modal">Cancelar</button><button id="save-customer-button" type="submit" class="primary-button">Guardar cliente</button></div>
  </form>
</dialog>
