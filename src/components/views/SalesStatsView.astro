<section id="view-sales-stats" class="app-view hidden space-y-6" data-admin-only>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-sm text-slate-500">Indicadores construidos a partir de las ventas registradas</p><h2 class="mt-1 text-2xl font-bold tracking-tight">Estadísticas de ventas</h2></div>
    <div class="flex flex-wrap items-end gap-3 rounded-xl border border-[#e3e9e2] bg-white p-3">
      <label class="filter-label">Desde<input id="stats-date-from" class="select-input mt-1" type="date" /></label>
      <label class="filter-label">Hasta<input id="stats-date-to" class="select-input mt-1" type="date" /></label>
    </div>
  </div>
  <p id="stats-date-error" class="hidden text-xs font-medium text-rose-600">La fecha inicial no puede ser posterior a la fecha final.</p>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="metric-card"><div class="flex items-start justify-between"><span class="metric-label">Total vendido</span><span class="metric-icon bg-emerald-50 text-emerald-700">$</span></div><p id="stats-total" class="metric-value">$0.00</p><p class="metric-note">Importe bruto de ventas</p></article>
    <article class="metric-card"><div class="flex items-start justify-between"><span class="metric-label">Transacciones</span><span class="metric-icon bg-sky-50 text-sky-700">▤</span></div><p id="stats-count" class="metric-value">0</p><p class="metric-note">Ventas en el período</p></article>
    <article class="metric-card"><div class="flex items-start justify-between"><span class="metric-label">Ticket promedio</span><span class="metric-icon bg-amber-50 text-amber-700">↗</span></div><p id="stats-average" class="metric-value">$0.00</p><p class="metric-note">Promedio por transacción</p></article>
    <article class="metric-card"><div class="flex items-start justify-between"><span class="metric-label">Unidades vendidas</span><span class="metric-icon bg-violet-50 text-violet-700">▦</span></div><p id="stats-units" class="metric-value">0</p><p class="metric-note">Unidades registradas</p></article>
  </div>
  <div class="grid gap-5 xl:grid-cols-2">
    <article class="panel-card">
      <div class="panel-heading"><div><h3 class="panel-title">Ventas por día</h3><p class="panel-caption">Importe y número de transacciones</p></div></div>
      <div id="stats-daily" class="space-y-4 px-5 pb-5"></div>
      <p id="stats-daily-empty" class="hidden px-5 pb-6 text-sm text-slate-400">No hay ventas en este período.</p>
    </article>
    <article class="panel-card overflow-hidden">
      <div class="panel-heading"><div><h3 class="panel-title">Ventas por método de pago</h3><p class="panel-caption">Distribución del importe vendido</p></div></div>
      <div id="stats-payments" class="space-y-4 px-5 pb-5"></div>
      <p id="stats-payments-empty" class="hidden px-5 pb-6 text-sm text-slate-400">No hay ventas en este período.</p>
    </article>
    <article class="panel-card overflow-hidden xl:col-span-2">
      <div class="panel-heading"><div><h3 class="panel-title">Productos más vendidos</h3><p class="panel-caption">Clasificación por unidades e importe generado</p></div></div>
      <div class="overflow-x-auto">
        <table class="data-table"><thead><tr><th>#</th><th>Producto</th><th class="text-right">Unidades</th><th class="text-right">Total vendido</th></tr></thead><tbody id="stats-products"></tbody></table>
      </div>
      <p id="stats-products-empty" class="hidden px-5 pb-6 text-sm text-slate-400">No hay productos vendidos en este período.</p>
    </article>
  </div>
  <p class="text-[11px] text-slate-400">El total vendido es bruto y no descuenta costos, gastos ni devoluciones.</p>
</section>
