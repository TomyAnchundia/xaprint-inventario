<section id="view-categories" class="app-view hidden space-y-6" data-admin-only>
  <div>
    <p class="text-sm text-slate-500">Organiza los productos del catálogo</p>
    <h2 class="mt-1 text-2xl font-bold tracking-tight">Categorías</h2>
  </div>

  <div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1fr)_380px]">
    <article class="panel-card overflow-hidden">
      <div class="panel-heading">
        <div>
          <h3 class="panel-title">Categorías registradas</h3>
          <p class="panel-caption">Las categorías con productos asignados no se pueden eliminar.</p>
        </div>
        <span id="category-count" class="text-xs font-medium text-slate-400">0 categorías</span>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>Nombre</th><th class="text-right">Acciones</th></tr></thead>
          <tbody id="categories-table"></tbody>
        </table>
      </div>
      <p id="categories-empty" class="hidden px-6 py-12 text-center text-sm text-slate-500">Todavía no hay categorías.</p>
    </article>

    <article class="panel-card">
      <form id="category-form">
        <div class="panel-heading">
          <div>
            <h3 id="category-form-title" class="panel-title">Nueva categoría</h3>
            <p class="panel-caption">Elige un nombre claro para identificar los productos.</p>
          </div>
        </div>
        <div class="space-y-4 px-5 pb-5">
          <input name="categoryId" type="hidden" />
          <label class="form-label">Nombre<input id="category-name" class="form-input" name="name" required maxlength="40" placeholder="Ej. Accesorios" /></label>
          <div class="flex justify-end gap-2">
            <button id="cancel-category-edit" type="button" class="secondary-button hidden">Cancelar</button>
            <button id="save-category-button" type="submit" class="primary-button">Crear categoría</button>
          </div>
        </div>
      </form>
    </article>
  </div>
</section>
