<section id="view-customers" class="app-view hidden space-y-6" data-admin-only>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm text-slate-500">Se muestran primero clientes con deuda; usa el buscador para encontrar cualquier cliente</p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight">Clientes</h2>
    </div>
    <button id="open-customer-crud" class="primary-button" type="button">
      <span class="text-lg leading-none">＋</span> Agregar cliente
    </button>
  </div>

  <article class="panel-card overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-[#edf0ec] p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
      <label class="search-field w-full sm:max-w-sm">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path stroke-linecap="round" d="m16 16 4.5 4.5"></path>
          </svg>
        </span>
        <input id="customer-crud-search" class="search-input" type="search" aria-label="Buscar clientes" placeholder="Buscar cualquier cliente por nombre, teléfono o cédula..." />
      </label>
      <span id="customer-crud-count" class="text-xs font-medium text-slate-400">0 clientes</span>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr><th>Nombre</th><th>Teléfono</th><th>Cédula</th><th>Dirección</th><th>Deuda</th><th class="text-right">Acciones</th></tr>
        </thead>
        <tbody id="customers-table"></tbody>
      </table>
    </div>
    <p id="customers-crud-empty" class="hidden px-6 py-12 text-center text-sm text-slate-500">No se encontraron clientes.</p>
  </article>
</section>
