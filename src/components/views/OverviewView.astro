<section id="view-overview" class="app-view space-y-7">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm text-slate-500">Vista general de tu negocio</p>
      <h2 id="overview-greeting" class="mt-1 text-2xl font-bold tracking-tight text-[#19241e]">Resumen de ventas <span aria-hidden="true">👋</span></h2>
    </div>
    <button class="primary-button" data-go="pos"><span class="text-lg leading-none">＋</span> Registrar venta</button>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="metric-card" data-admin-only>
      <div class="flex items-start justify-between"><span class="metric-label">Productos activos</span><span class="metric-icon bg-emerald-50 text-emerald-700">▦</span></div>
      <p id="metric-products" class="metric-value">0</p><p class="metric-note">Referencias en catálogo</p>
    </article>
    <article class="metric-card" data-admin-only>
      <div class="flex items-start justify-between"><span class="metric-label">Unidades en stock</span><span class="metric-icon bg-sky-50 text-sky-700">◷</span></div>
      <p id="metric-stock" class="metric-value">0</p><p class="metric-note">En todas las categorías</p>
    </article>
    <article class="metric-card">
      <div class="flex items-start justify-between"><span class="metric-label">Ventas de hoy</span><span class="metric-icon bg-amber-50 text-amber-700">$</span></div>
      <p id="metric-sales" class="metric-value">$0.00</p><p id="metric-sales-count" class="metric-note">0 transacciones</p>
    </article>
    <article class="metric-card" data-admin-only>
      <div class="flex items-start justify-between"><span class="metric-label">Por reponer</span><span class="metric-icon bg-rose-50 text-rose-700">!</span></div>
      <p id="metric-low-stock" class="metric-value">0</p><p class="metric-note">Productos bajo el mínimo</p>
    </article>
  </div>

  <div class="grid gap-5 xl:grid-cols-[1.3fr_0.7fr]" data-admin-only>
    <article class="panel-card overflow-hidden">
      <div class="panel-heading">
        <div><h3 class="panel-title">Movimientos recientes</h3><p class="panel-caption">Actividad del inventario</p></div>
        <button class="text-xs font-semibold text-[#287052] hover:text-[#173d32]" data-go="movements">Ver todos →</button>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>Producto</th><th>Tipo</th><th class="text-right">Cantidad</th><th class="text-right">Fecha</th></tr></thead>
          <tbody id="overview-movements"></tbody>
        </table>
      </div>
    </article>
    <article class="panel-card">
      <div class="panel-heading">
        <div><h3 class="panel-title">Stock bajo</h3><p class="panel-caption">Revisa estos productos pronto</p></div>
        <span id="low-stock-badge" class="rounded-lg bg-rose-50 px-2.5 py-1 text-[11px] font-bold text-rose-700">0 alertas</span>
      </div>
      <div id="low-stock-list" class="space-y-1 px-5 pb-4"></div>
      <button class="mx-5 mb-5 mt-2 text-xs font-semibold text-[#287052] hover:text-[#173d32]" data-go="products">Ir a productos →</button>
    </article>
  </div>
</section>
